# PielSana IA: copiar a .env y completar. NUNCA subir .env al repositorio.
# En local con Docker (sin DuckDNS): DOMAIN=localhost, DUCKDNS_* con cualquier
# valor y levantar solo backend y web:  docker compose up --build backend web

# ===== Obligatorias =====

# Dominio completo, sin https:// (Caddy emite el certificado para este nombre)
DOMAIN=pielsana.duckdns.org

# DuckDNS: solo el subdominio (lo que va antes de .duckdns.org) y el token de duckdns.org
DUCKDNS_SUBDOMAIN=pielsana
DUCKDNS_TOKEN=

# API key de DeepSeek (sin ella, los endpoints de IA responden 503)
DEEPSEEK_API_KEY=

# ===== Opcionales (vacías = valor por defecto) =====

# Orígenes permitidos por CORS, separados por coma. Vacío = cualquiera.
ALLOWED_ORIGINS=https://pielsana.duckdns.org

# Modelo del LLM (por defecto deepseek-flash, que acepta imágenes)
LLM_MODEL=
# URL del proveedor (por defecto https://api.deepseek.com)
LLM_BASE_URL=
# Rate limit por IP de los endpoints de IA (por defecto 10/minute)
RATE_LIMIT_IA=
# Tamaño máximo de imagen en MB (por defecto 5)
MAX_IMAGE_MB=
