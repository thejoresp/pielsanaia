# Copiar a .env en la VPS y completar. NUNCA subir .env al repositorio.

# Dominio completo de DuckDNS (sin https://)
DOMAIN=pielsana.duckdns.org

# Solo el subdominio (lo que va antes de .duckdns.org) y el token de tu cuenta en duckdns.org
DUCKDNS_SUBDOMAIN=pielsana
DUCKDNS_TOKEN=

# Backend
DEEPSEEK_API_KEY=
# Modelo opcional (por defecto deepseek-flash, que acepta imágenes)
# LLM_MODEL=deepseek-flash
# URL opcional del proveedor (por defecto https://api.deepseek.com)
# LLM_BASE_URL=https://api.deepseek.com
# Rate limit por IP para los endpoints de IA (por defecto 10/minute)
# RATE_LIMIT_IA=10/minute
# Tamaño máximo de imagen en MB (por defecto 5)
# MAX_IMAGE_MB=5
# Orígenes permitidos por CORS (separados por coma). Vacío = cualquiera.
ALLOWED_ORIGINS=https://pielsana.duckdns.org
